# AI Service
AI_SERVICE_URL=http://localhost:8000

# Database (PostgreSQL on Railway or local)
DATABASE_URL=postgresql://user:password@host:5432/construction_estimator

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=construction-estimator-uploads
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-custom-domain.com

# For frontend (public)
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-custom-domain.com

# Authentication (to be added)
NEXTAUTH_SECRET=
NEXTAUTH_URL=
